# Bu faylni nusxalab ".env.local" deb nomlang (faqat kompyuterda sinash uchun).
# Vercel'da esa shu 4 ta qiymatni Settings -> Environment Variables bo'limiga kiriting.

# Supabase -> Project Settings -> API -> Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase -> Project Settings -> API -> service_role (secret) kaliti.
# HECH KIMGA BERMANG va kod ichiga yozmang.
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel sessiyasini imzolash uchun uzun tasodifiy matn (kamida 40 belgi).
ADMIN_SECRET=

# Saytingiz manzili, oxirida "/" siz. Domen ulanmaguncha Vercel bergan manzilni yozing.
NEXT_PUBLIC_SITE_URL=https://usmanovceramic.uz
